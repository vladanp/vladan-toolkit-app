{
  "name": "vladan-toolkit",
  "private": true,
  "version": "0.1.0",
  "description": "Vladan Toolkit: an all-in-one desktop toolkit for macOS, Windows and Linux.",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/native",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:secrets": "secretlint \"**/*\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "REACT_COMPILER=off vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "e2e:native:build": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e:native": "wdio run e2e/native/wdio.conf.ts",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "bindings": "UPDATE_BINDINGS=1 cargo test --manifest-path src-tauri/Cargo.toml bindings_are_up_to_date",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm lint:rust && pnpm test:rust",
    "new:tool": "node scripts/new-tool.ts",
    "prepare": "lefthook install",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "clsx": "^2.1.1",
    "cmdk-base": "^1.0.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.7",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "@wdio/types": "^9.32.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "expect-webdriverio": "^6.1.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "secretlint": "^13.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0",
    "webdriverio": "^9.32.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
