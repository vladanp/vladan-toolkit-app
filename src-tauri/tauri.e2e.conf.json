{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "pnpm build:web --mode e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e",
          "description": "Native end-to-end tests only (cargo feature `e2e`). Never shipped.",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  }
}
